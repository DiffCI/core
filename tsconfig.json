{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "esModuleInterop": true, "strict": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "declaration": true, "sourceMap": true,
    "rootDir": "src", "outDir": "dist", "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}
