{
  "name": "@diffci.com/diffci",
  "version": "0.3.29",
  "description": "Fail-closed, change-aware verification for AI coding agents with conservative affected-test selection",
  "keywords": [
    "ci",
    "cicd",
    "ci-cd",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "grok",
    "test-selection",
    "test-impact-analysis",
    "affected-tests",
    "github-actions"
  ],
  "license": "MIT",
  "mcpName": "io.github.DiffCI/diffci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiffCI/core.git",
    "directory": "packages/diffci-cli"
  },
  "bugs": {
    "url": "https://github.com/DiffCI/core/issues"
  },
  "homepage": "https://diffci.com/",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/DiffCI"
    },
    {
      "type": "thanks.dev",
      "url": "https://thanks.dev/u/gh/diffci"
    }
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "diffci": "dist-client/src/client/cli.js",
    "diffci-mcp": "dist-client/src/client/mcp.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist-client/src/client/*.d.ts",
      "default": "./dist-client/src/client/*.js"
    }
  },
  "files": [
    "dist-client/src/client",
    "dist-client/src/preflight",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:client",
    "build:client": "tsc -p tsconfig.client.json && node scripts/ensure-client-executables.mjs",
    "prepack": "npm run build:client",
    "package:check": "node scripts/check-package-boundary.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@diffci.com/core": "git+https://github.com/DiffCI/core.git#a5f1c26963846cb4cd9df1f9d495e3c99373a64b",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "bundleDependencies": [
    "@diffci.com/core"
  ]
}
